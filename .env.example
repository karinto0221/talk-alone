# Docker Composeとローカル起動で共通利用する設定
DB_HOST=localhost
DB_PORT=5434
DB_NAME=talk_alone
DB_USER=talk_alone
DB_PASSWORD=replace_with_a_password

# ローカルでNestJSを直接起動する場合
PORT=3100
CORS_ORIGIN=http://localhost:5173

# 未設定なら内蔵のお題とヒントを利用します
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
